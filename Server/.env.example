# Entorno
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS y WebSockets (separados por coma)
CORS_ORIGINS=http://localhost:4200

# Base de datos (coincide con docker-compose.yml)
DB_PORT=5432
POSTGRES_USER=tunari
POSTGRES_PASSWORD=tunari_dev
POSTGRES_DB=tunari_guard
DATABASE_URL=postgresql://tunari:tunari_dev@localhost:5432/tunari_guard?schema=public

# Integraciones de fases siguientes (dejar vacío hasta usarlas)
FIRMS_MAP_KEY=
LLM_API_KEY=
N8N_ALERT_WEBHOOK_URL=
