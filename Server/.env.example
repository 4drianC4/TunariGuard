# Entorno
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS y WebSockets (separados por coma)
CORS_ORIGINS=http://localhost:4200

# Base de datos (coincide con docker-compose.yml). Puerto 5433 para no chocar con un
# PostgreSQL instalado en Windows/macOS, que suele ocupar 5432. Si cambias DB_PORT o la
# contraseña, cámbialos también en DATABASE_URL. Diagnóstico: npm run db:doctor
DB_PORT=5433
POSTGRES_USER=tunari
POSTGRES_PASSWORD=tunari_dev
POSTGRES_DB=tunari_guard
DATABASE_URL=postgresql://tunari:tunari_dev@127.0.0.1:5433/tunari_guard?schema=public

# Almacenamiento S3 (MinIO en docker-compose.yml). Consola web: http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
# Host con el que se firman las URLs de subida; cambiar por la IP de la máquina si otros
# miembros del equipo suben desde su propio equipo (p. ej. http://192.168.1.20:9000)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=tunari
S3_SECRET_KEY=tunari_dev_secret
S3_BUCKET=tunari-guard-uploads

# Integraciones de fases siguientes (dejar vacío hasta usarlas)
# Sincronización con NASA FIRMS. Vacío: activa solo en producción. En local, true para probarla.
FIRMS_SYNC_ENABLED=
FIRMS_SYNC_INTERVAL_MINUTES=10
FIRMS_MAP_KEY=
LLM_API_KEY=
N8N_ALERT_WEBHOOK_URL=
