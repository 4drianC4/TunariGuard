# Copiar a .env.production (está fuera de Git) y cambiar TODOS los valores de ejemplo.
# Usa contraseñas largas solo con letras y números: van dentro de una URL de conexión.
# Generar una: openssl rand -hex 24

# Dominio que apunta a la IP del VPS (registro A). Caddy saca el certificado HTTPS solo.
DOMAIN=ivento.tech
# Solo si el VPS ya tiene otro proxy (nginx, Traefik) en 80/443: SITE_ADDRESS=:80 (ver DEPLOY.md)
SITE_ADDRESS=

# Base de datos (solo accesible dentro de Docker)
POSTGRES_USER=tunari
POSTGRES_PASSWORD=cambia_esto_por_una_clave_larga
POSTGRES_DB=tunari_guard

# MinIO / S3 (solo accesible dentro de Docker)
S3_ACCESS_KEY=tunari
S3_SECRET_KEY=cambia_esto_por_otra_clave_larga
S3_BUCKET=tunari-guard-uploads

# Tuni (IA). Opcional: sin clave, Tuni responde solo las preguntas directas.
LLM_API_KEY=
OPENAI_API_KEY=
TUNI_CHAT_MODEL=

# Sincronización NASA FIRMS (fase futura)
FIRMS_MAP_KEY=
